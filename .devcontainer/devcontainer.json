{
  "name": "Language Detector & Translator",
  "dockerFile": "Dockerfile",
  "context": "..",
  "appPort": ["8501:8501"],
  "settings": {
    "terminal.integrated.shell.linux": "/bin/bash"
  },
  "remoteUser": "root",
  "postCreateCommand": "pip install -r app/requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}